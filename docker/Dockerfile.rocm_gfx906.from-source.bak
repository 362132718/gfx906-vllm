# ROCm 7.2.4 base with gfx906 support
ARG BASE_IMAGE=rocm/dev-ubuntu-24.04:7.2.4-complete
ARG TRITON_BRANCH="f0b55c0"
ARG TRITON_REPO="https://gitee.com/mirrors/triton.git"
ARG PYTORCH_BRANCH="6bbd260"
ARG PYTORCH_REPO="https://gitee.com/ascend/pytorch.git"
ARG PYTORCH_VISION_BRANCH="v0.27.1"
ARG PYTORCH_VISION_REPO="https://gitee.com/mirrors/vision.git"
ARG PYTORCH_AUDIO_BRANCH="v2.11.0"
ARG PYTORCH_AUDIO_REPO="https://gitee.com/mirrors/audio.git"
ARG FA_BRANCH="0e60e394"
ARG FA_REPO="https://gitee.com/mirrors/flash-attention.git"

FROM ${BASE_IMAGE} AS base

ENV PATH=/opt/rocm/llvm/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV ROCM_PATH=/opt/rocm
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/usr/local/lib:

# CRITICAL: Add gfx906 to the architecture list
ARG PYTORCH_ROCM_ARCH=gfx906;gfx90a;gfx942;gfx950;gfx1100;gfx1101;gfx1200;gfx1201;gfx1150;gfx1151
ENV PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH}

ENV HSA_NO_SCRATCH_RECLAIM=1

# Set VLLM_TARGET_DEVICE for ROCm builds
ENV VLLM_TARGET_DEVICE=rocm

# Optimize Triton attention for gfx906 (MI50, 60 CU)
# Per Z100 adaptation notes: 64 segments is optimal (+26% 8K decode), 128 gives no further gain
ENV VLLM_TRITON_ATTN_NUM_SEGMENTS=64

ARG PYTHON_VERSION=3.12
ENV PYTHON_VERSION=${PYTHON_VERSION}

RUN mkdir -p /app
WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies (base image already has Python 3.12)
RUN apt-get update -y \
    && apt-get install -y git curl sudo vim less libgfortran5 \
    && python3 --version && python3 -m pip --version || true \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --break-system-packages --no-deps packaging 'cmake<4' ninja pybind11 Cython && \
    pip install --break-system-packages --upgrade --ignore-installed 'setuptools<80' 'wheel>=0.48.0'
RUN apt-get update && apt-get install -y libjpeg-dev libsox-dev libsox-fmt-all sox && rm -rf /var/lib/apt/lists/*

# Build Triton
FROM base AS build_triton
ARG TRITON_BRANCH
ARG TRITON_REPO
RUN git clone ${TRITON_REPO}
RUN cd triton \
    && git checkout ${TRITON_BRANCH} \
    && if [ ! -f setup.py ]; then cd python; fi \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && mkdir -p /app/install && cp dist/*.whl /app/install

# Build amdsmi
FROM base AS build_amdsmi
RUN cd /opt/rocm/share/amd_smi \
    && PIP_BREAK_SYSTEM_PACKAGES=1 pip wheel . --wheel-dir=dist
RUN mkdir -p /app/install && cp /opt/rocm/share/amd_smi/dist/*.whl /app/install

# Build PyTorch with gfx906 support
FROM base AS build_pytorch
ARG PYTORCH_BRANCH
ARG PYTORCH_VISION_BRANCH
ARG PYTORCH_REPO
ARG PYTORCH_VISION_REPO
ARG PYTORCH_AUDIO_BRANCH
ARG PYTORCH_AUDIO_REPO

RUN git clone ${PYTORCH_REPO} pytorch
RUN cd pytorch && git checkout ${PYTORCH_BRANCH} \
    && pip install --break-system-packages -r requirements.txt && git submodule update --init --recursive \
    && python3 tools/amd_build/build_amd.py \
    && CMAKE_PREFIX_PATH=$(python3 -c 'import sys; print(sys.prefix)') python3 setup.py bdist_wheel --dist-dir=dist \
    && pip install --break-system-packages dist/*.whl

RUN git clone ${PYTORCH_VISION_REPO} vision
RUN cd vision && git checkout ${PYTORCH_VISION_BRANCH} \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && pip install --break-system-packages dist/*.whl

RUN git clone ${PYTORCH_AUDIO_REPO} audio
RUN cd audio && git checkout ${PYTORCH_AUDIO_BRANCH} \
    && git submodule update --init --recursive \
    && pip install --break-system-packages -r requirements.txt \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && pip install --break-system-packages dist/*.whl

RUN mkdir -p /app/install && cp /app/pytorch/dist/*.whl /app/install \
    && cp /app/vision/dist/*.whl /app/install \
    && cp /app/audio/dist/*.whl /app/install

# Build Flash Attention
FROM base AS build_fa
ARG FA_BRANCH
ARG FA_REPO
RUN --mount=type=bind,from=build_pytorch,src=/app/install/,target=/install \
    pip install --break-system-packages /install/*.whl
RUN git clone ${FA_REPO}
RUN cd flash-attention \
    && git checkout ${FA_BRANCH} \
    && git submodule update --init \
    && GPU_ARCHS=$(echo ${PYTORCH_ROCM_ARCH} | sed -e 's/;gfx1[0-9]\{3\}//g') python3 setup.py bdist_wheel --dist-dir=dist
RUN mkdir -p /app/install && cp /app/flash-attention/dist/*.whl /app/install

# Collect all wheels
FROM base AS debs
RUN mkdir /app/debs
RUN --mount=type=bind,from=build_triton,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_fa,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_amdsmi,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_pytorch,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs

# Final image with all components
FROM base AS final
RUN --mount=type=bind,from=debs,src=/app/debs,target=/install \
    pip install --break-system-packages /install/*.whl

# Copy gfx906 supplement files (to be mounted from host)
COPY gfx906-supplements/ /opt/rocm/lib/gfx906-supplements/

# Apply gfx906-specific patches for Triton attention optimization
# This modifies BLOCK size from 16 to 32 for gfx906 based on Z100 adaptation notes
RUN if [ -f /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/triton_decode_attention.py ]; then \
        sed -i 's/if is_hip_:/if is_hip_ and not current_platform.is_gfx906():/' \
            /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/triton_decode_attention.py && \
        echo "Applied gfx906 BLOCK=32 optimization patch"; \
    fi

ARG BASE_IMAGE
ARG TRITON_BRANCH
ARG PYTORCH_BRANCH
ARG FA_BRANCH
RUN echo "BASE_IMAGE: ${BASE_IMAGE}" > /app/versions.txt \
    && echo "TRITON_BRANCH: ${TRITON_BRANCH}" >> /app/versions.txt \
    && echo "PYTORCH_BRANCH: ${PYTORCH_BRANCH}" >> /app/versions.txt \
    && echo "FA_BRANCH: ${FA_BRANCH}" >> /app/versions.txt \
    && echo "PYTORCH_ROCM_ARCH: ${PYTORCH_ROCM_ARCH}" >> /app/versions.txt

CMD ["/bin/bash"]
